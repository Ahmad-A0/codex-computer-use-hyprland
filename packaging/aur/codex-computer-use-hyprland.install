post_install() {
  cat <<'EOF'
==> To use the provider, run as each desktop user (not root):
      codex-computer-use-hyprland register
    It builds the Hyprland plugin into ~/.cache/codex-computer-use-hyprland,
    adds cua_repl to ~/.codex/config.toml (keeping a backup) and enables the
    codex-hyprland-prebuild.path user unit. Then start a new Codex session.
    Check the setup with: codex-computer-use-hyprland doctor
EOF
}

post_upgrade() {
  cat <<'EOF'
==> New Codex sessions use the updated provider; the plugin is rebuilt in
    ~/.cache/codex-computer-use-hyprland on first use when its sources changed.
EOF
}

post_remove() {
  cat <<'EOF'
==> Users who ran `codex-computer-use-hyprland register` (run `unregister`
    before removing the package to do this automatically) should remove the
    [mcp_servers.cua_repl] tables from ~/.codex/config.toml, run
    `systemctl --user disable codex-hyprland-prebuild.path`, and may delete
    ~/.cache/codex-computer-use-hyprland. A loaded plugin stays in Hyprland
    until the next login.
EOF
}
