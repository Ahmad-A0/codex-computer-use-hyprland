#!/bin/sh
set -eu
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$project_dir"
case "${1:-}" in
  ''|--project|--no-config) ;;
  *) echo 'Usage: ./install [--project|--no-config]' >&2; exit 1 ;;
esac
if [ "$#" -gt 1 ]; then
  echo 'Usage: ./install [--project|--no-config]' >&2
  exit 1
fi
. "$project_dir/scripts/runtime.sh"
./scripts/setup.sh
# Same registration as the system package's `codex-computer-use-hyprland register`.
exec ./bin/codex-computer-use-hyprland register "$@"
