[Unit]
Description=Prebuild the Codex Hyprland plugin for the installed Hyprland headers

[Service]
Type=oneshot
Nice=10
# @ROOT@ is the installation directory: a checkout's path, substituted by
# `register` into ~/.config/systemd/user, or /usr/lib/codex-computer-use-hyprland,
# substituted when the package is built.
ExecStart=@ROOT@/scripts/build-native.sh
